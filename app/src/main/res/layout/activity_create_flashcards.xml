<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studyBuddy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#041459"
    tools:context=".createFlashcardsActivity" >

    <TextView
        android:id="@+id/titleName4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="112dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="112dp"
        android:text="Study Buddy"
        android:textColor="#2196F3"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/FlashcardNameText"
        android:layout_width="247dp"
        android:layout_height="59dp"
        android:layout_marginStart="101dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="100dp"
        android:ems="10"
        android:hint="Enter Flashcard Title:"
        android:inputType="text"
        android:textColor="#F3FFFFFF"
        android:textColorHint="#EEFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleName4" />

    <EditText
        android:id="@+id/flashcardTermInput"
        android:layout_width="247dp"
        android:layout_height="59dp"
        android:layout_marginStart="101dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="100dp"
        android:ems="10"
        android:hint="Enter Term:"
        android:inputType="text"
        android:textColor="#F3FFFFFF"
        android:textColorHint="#EEFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/FlashcardNameText" />

    <EditText
        android:id="@+id/flashcardDefinitionInput"
        android:layout_width="247dp"
        android:layout_height="59dp"
        android:layout_marginStart="101dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="100dp"
        android:ems="10"
        android:hint="Enter Definition:"
        android:inputType="text"
        android:textColor="#F3FFFFFF"
        android:textColorHint="#EEFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashcardTermInput" />

    <Button
        android:id="@+id/createFlashcardSetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="71dp"
        android:layout_marginTop="107dp"
        android:backgroundTint="#2196F3"
        android:text="Create"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashcardDefinitionInput" />

    <Button
        android:id="@+id/nextFlashcardButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="71dp"
        android:backgroundTint="#2196F3"
        android:text="Save and Next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toEndOf="@+id/createFlashcardSetButton"
        app:layout_constraintTop_toBottomOf="@+id/flashcardDefinitionInput" />
</androidx.constraintlayout.widget.ConstraintLayout>